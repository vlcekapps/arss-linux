{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vlcekapps/arss-contract/schemas/normalized-guide-program.schema.json",
  "title": "ARSS normalized guide programme golden result",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "source", "stationId", "date", "programs"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "source": {"type": "string", "minLength": 1},
    "stationId": {"type": "string", "pattern": "^(tv|radio)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "date": {"type": "string", "format": "date"},
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startMillis", "endMillis", "title", "description", "audioDescription", "audioDescriptionKnown", "programUrl", "archiveUrl"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "startMillis": {"type": "integer", "minimum": 0},
          "endMillis": {"type": ["integer", "null"], "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "audioDescription": {"type": "boolean"},
          "audioDescriptionKnown": {"type": "boolean"},
          "programUrl": {"type": ["string", "null"], "format": "uri"},
          "archiveUrl": {"type": ["string", "null"], "format": "uri"}
        }
      }
    }
  }
}
