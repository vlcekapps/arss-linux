{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vlcekapps/arss-contract/schemas/normalized-feed.schema.json",
  "title": "ARSS normalized feed golden result",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sourceUrl", "title", "items"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "sourceUrl": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "sourceId", "publishedText", "publishedAtMillis", "mediaUrl", "mediaType", "durationText"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "sourceId": {"type": ["string", "null"]},
          "publishedText": {"type": ["string", "null"]},
          "publishedAtMillis": {"type": ["integer", "null"], "minimum": 0},
          "mediaUrl": {"type": ["string", "null"], "format": "uri"},
          "mediaType": {"type": ["string", "null"]},
          "durationText": {"type": ["string", "null"]}
        }
      }
    }
  }
}
