{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vlcekapps/arss-contract/schemas/guide-sources.schema.json",
  "title": "ARSS guide providers",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sources"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "medium", "role", "baseUrl", "format", "priority", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "medium": {"enum": ["television", "radio"]},
          "role": {"enum": ["discovery", "schedule"]},
          "baseUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
          "format": {"enum": ["json", "xml", "html"]},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
